{
  "name": "forge-runner",
  "version": "1.0.0",
  "private": true,
  "description": "Forge Runner: endless browser runner served by an AWS Lambda Function URL",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:poki": "node scripts/build-poki.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "node scripts/test-build.mjs",
    "test:missions": "node --test scripts/test-missions.mjs",
    "test:missions-browser": "node scripts/test-missions-browser.mjs",
    "test:telemetry": "node --test scripts/test-telemetry.mjs",
    "test:poki-browser": "node scripts/test-poki-browser.mjs",
    "test:canvas": "node scripts/test-canvas.mjs",
    "test:canvas:update": "node scripts/test-canvas.mjs --update",
    "test:sparks-browser": "node scripts/test-sparks-browser.mjs",
    "test:orecart-browser": "node scripts/test-orecart-browser.mjs",
    "test:chaser-browser": "node scripts/test-chaser-browser.mjs",
    "build:lab": "node scripts/build-lab.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "1.64.1"
  }
}
